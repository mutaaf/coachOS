{
  "name": "coachos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=web",
    "dev:bot": "turbo dev --filter=whatsapp-bot",
    "db:migrate": "cd supabase && supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run db:start && npm run db:reset && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.112.4",
    "tsx": "^4.23.13",
    "turbo": "^2.3.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "npm@10.2.0"
}
